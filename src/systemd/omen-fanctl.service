[Unit]
Description=omen-fanctl automatic fan controller for HP board 8D87
Documentation=file:/usr/local/share/doc/omen-fanctl/README.md
ConditionPathExists=/sys/firmware/acpi/platform_profile
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/lib/omen-fanctl/omen-fanctl --apply --config /etc/omen-fanctl/omen-fanctl.toml --status-interval 30
ExecStopPost=/usr/local/lib/omen-fanctl/omen-fanctl --failsafe
Restart=always
RestartPreventExitStatus=78
RestartSec=10
WatchdogSec=15
WatchdogSignal=SIGKILL
# Covers the sequential 20-second platform-profile, hp-wmi, and k10temp windows.
TimeoutStartSec=90
TimeoutStopSec=15
KillSignal=SIGTERM

RuntimeDirectory=omen-fanctl
RuntimeDirectoryMode=0750
LogsDirectory=omen-fanctl
LogsDirectoryMode=0750
WorkingDirectory=/var/log/omen-fanctl
UMask=0027

NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
